# 复制为 .env 并按实际环境修改

# 服务监听
# 生产部署必须设为 production；会强制独立加密主密钥、Secure Cookie 等硬门槛
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# 同源部署留空；跨域前端填写逗号分隔的精确 Origin，例如 https://console.example.com
CORS_ORIGINS=
# 仅当应用位于会清洗并重写 X-Forwarded-For 的可信反向代理后方时开启
TRUST_PROXY_HEADERS=false

# 数据根目录（Logo、导出件、知识库、SQLite 库等落盘位置）。默认 <repo>/data。
# 多实例部署或跑测试时指向不同目录以隔离数据，避免相互污染/覆盖。
# APP_DATA_DIR=

# JWT 密钥（必须 ≥32 字节随机串；默认/占位值会被拒绝启动）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# HTTPS 生产环境设为 true；HTTPS 请求本身也会自动写入 Secure Cookie
AUTH_COOKIE_SECURE=false
# 数据库 API Key/OAuth/MCP/渠道凭据的信封加密主密钥（建议独立随机串，至少 32 字节）
SECRET_MASTER_KEY=please-use-a-separate-long-random-master-key
# 轮换期间可暂存旧密钥，多个以逗号分隔。当前没有覆盖所有加密列的批量 rewrap；
# 必须按 RELEASE.md 逐表验证全部密文已用新主密钥重写后才能移除。
SECRET_MASTER_KEY_PREVIOUS=

# 初始 root 账号（仅首次启动建库时生效；默认口令会被拒绝启动）
ROOT_USERNAME=root
ROOT_PASSWORD=Root@123456

# ---- 安全开关 ----
# 开发环境放行上面的默认密钥/口令（生产务必保持 false）
ALLOW_INSECURE_DEFAULTS=false
# SSRF：默认拒绝 MCP / 模型提供商 URL 指向 环回/内网/链路本地 网段。
# 对接内网模型网关或内网 MCP 时，可整体放行，或用 SSRF_ALLOWLIST 精确放行。
SSRF_ALLOW_PRIVATE=false
# 逗号分隔的 host 或 CIDR（如 127.0.0.1,10.0.0.0/8,gw.local）
SSRF_ALLOWLIST=

# ---- Harness 内置执行能力 ----
# 工作区文件、Git、LSP 和受限 Shell 只能访问此根目录；生产建议指向独立 worktree。
# AGENT_WORKSPACE_ROOT=D:\worktrees\agent-runtime
BUILTIN_TOOLS_ENABLED=true
# 只有配置了真正的低权限容器/账号包装器时才开启
SHELL_TOOL_ENABLED=false
SHELL_TIMEOUT_SECONDS=60
SHELL_OUTPUT_CHARS=20000
BROWSER_TIMEOUT_SECONDS=30
# 免费联网检索：推荐填写自托管 SearXNG；留空时使用 DuckDuckGo + Bing
# 低频聚合，不需要 API Token。内网实例还需加入上方 SSRF_ALLOWLIST。
# SEARXNG_URL=http://127.0.0.1:8080
WEB_SEARCH_FALLBACK=true
WEB_SEARCH_TIMEOUT_SECONDS=15
# 仅对超时、连接错误、HTTP 429/5xx 做有界重试；4xx 与内容校验失败不重试
WEB_REQUEST_MAX_RETRIES=2
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_CHARS=20000
# 启用持久 Cron 调度；到期任务进入同一 Job Worker。
CRON_SCHEDULER_ENABLED=true
# 单条 Cron 派发失败的指数退避范围，以及健康检查判定心跳失效阈值。
CRON_RETRY_BASE_SECONDS=30
CRON_RETRY_MAX_SECONDS=3600
CRON_HEARTBEAT_STALE_SECONDS=60

# 可选：OpenAI Images 兼容图片生成端点。未配置时仍可用 image_render 生成 SVG。
# IMAGE_API_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# 可选：支持 multipart /images/edits 的图片编辑服务。只有三项均配置时，
# photo-abstract-editorial 才会让图片模型生成抽象面板；失败会回退本地 v3。
# IMAGE_EDIT_API_BASE_URL=https://api.openai.com/v1
# IMAGE_EDIT_API_KEY=
# IMAGE_EDIT_MODEL=gpt-image-1
# 生成图片落盘前的安全上限；Provider 原生图片与独立 IMAGE_* 回退共用。
IMAGE_OUTPUT_MAX_MB=25
IMAGE_MAX_PIXELS=80000000

# 本地 LLM（OpenAI 兼容接口）
# Ollama:      http://127.0.0.1:11434/v1
# vLLM:        http://127.0.0.1:8001/v1
# LM Studio:   http://127.0.0.1:1234/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
# 文本模型（项目摘要/分析/报告生成），建议 14B 以上中文模型
LLM_TEXT_MODEL=qwen2.5:14b
# 视觉模型（卫星图/CAD图纸/电费单识别），必须支持多模态
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
# 多轮对话上下文预算（token，估算）：默认本地模型的上下文窗口。对话历史超过约 70% 预算时，
# 自动把较早的对话压缩成摘要再续聊（实现按模型能力自动压缩）。可被各模型提供商的「上下文窗口」
# 设置（context_tokens）逐个覆盖；填模型实际窗口（如 32768、131072）效果最佳。
LLM_CONTEXT_TOKENS=8192

# 上传限制（MB）
MAX_FILE_MB=15
# 无运行中任务引用的上传件保留时间（秒）
UPLOAD_TTL_SECONDS=86400

# 数据库共享的应用级固定窗口限流；网关仍建议配置第一层限流
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
OPEN_API_RATE_LIMIT=60
OPEN_API_RATE_WINDOW_SECONDS=60
OPEN_API_SYNC_WAIT_SECONDS=60
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
# 共享限流桶最长保留时间（秒）；过期数据由 Worker 周期清理
RATE_LIMIT_BUCKET_TTL_SECONDS=86400

# ---- 任务队列 / worker（长流水线后台化，M1）----
# 进程内 worker：单机部署默认开启。多副本部署时，API 进程设为 false，
# 另起独立 worker：python run.py worker（建议同时把 DATABASE_URL 切到 Postgres）。
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=4
# 每用户在途（排队/运行/待批准）与同时运行上限；全局排队上限防止耗尽磁盘/内存
JOB_MAX_INFLIGHT_PER_USER=8
JOB_MAX_RUNNING_PER_USER=2
JOB_MAX_QUEUED_GLOBAL=1000
JOB_QUEUE_WARN_PENDING=100
# 健康检查是否要求至少一个最近有心跳的 Worker（API-only 维护节点可设 false）
HEALTH_REQUIRE_WORKER=true
# 跨进程流式部分答案批量落库阈值（避免逐 token 写库）
JOB_PARTIAL_FLUSH_CHARS=512
JOB_PARTIAL_FLUSH_SECONDS=0.5
JOB_POLL_SECONDS=1.0
JOB_HEARTBEAT_SECONDS=20
# 仅明确的连接/超时类任务错误进入有界 Job 重试。
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
# Worker 停机等待在跑任务自然结束的上限；超时后停止本地执行并等待租约恢复。
JOB_SHUTDOWN_GRACE_SECONDS=30
# 父任务取消时最多级联的任务树节点数。
JOB_CANCEL_CASCADE_LIMIT=100
# 会话标题后台生成超时；答案和 Job 终态不等待标题模型
TITLE_GENERATION_TIMEOUT_SECONDS=5.0
# 新引导被当前任务领取前的撤回/编辑窗口（秒）
JOB_GUIDANCE_GRACE_SECONDS=3.0
# 心跳租约（秒，须 > 心跳间隔）：running 任务超时无心跳即视为 worker 失联并重新入队
JOB_LEASE_SECONDS=120
# 终态任务保留时长（秒），过期清理
JOB_TTL_SECONDS=1800

# 数据库（默认 SQLite 单机文件；多副本横向扩展请切 Postgres）
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/greencarbon

# ---- MCP 工具密钥（按需自定义）----
# MCP 服务的 url / 附加请求头里可写 ${变量名} 占位符，发请求时从这里的环境变量替换，
# 这样 API Key 只存 .env、不落数据库、也不会随 MCP 导出泄露。
# 例：在管理后台「MCP」里把请求头填 {"Authorization": "Bearer ${TAVILY_API_KEY}"}，
#     或把 url 填 https://api.tavily.com/...?api_key=${TAVILY_API_KEY}，再在此处提供：

# Tavily 已不是默认依赖；如需付费增强，可自行创建 MCP 服务并配置密钥。
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Tushare 金融数据（内置示例 MCP「Tushare 金融数据」用到）
# 申请：https://tushare.pro  → 个人主页「接口TOKEN」
# TUSHARE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
