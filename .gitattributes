* text=auto

# Cross-platform source and CI files stay deterministic in the repository.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows launchers should remain directly executable from Explorer/cmd.
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Reference and generated media must never receive line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.zip binary
